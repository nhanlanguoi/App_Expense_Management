PORT=3000
NODE_ENV=development
SESSION_SECRET=replace-with-a-strong-secret

# Comma-separated URL or a single URL from Flutter/Web app
CORS_ORIGIN=http://localhost:3000

# Choose ONE of the following for Firebase Admin:
# 1) Inline JSON (single line JSON string)
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}

# 2) Or use file path through GOOGLE_APPLICATION_CREDENTIALS env var
# GOOGLE_APPLICATION_CREDENTIALS=D:/path/to/serviceAccountKey.json

# OTP email sender (Gmail SMTP + App Password)
# MAIL_USER=your_gmail@gmail.com
# MAIL_APP_PASSWORD=your_gmail_app_password
# MAIL_FROM=Expense Management <your_gmail@gmail.com>

# OTP settings
OTP_EXPIRES_MINUTES=10
OTP_RESEND_COOLDOWN_SECONDS=60
